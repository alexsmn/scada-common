@startuml opcua_module_overview
!include _style.puml

title OPC UA module overview — server and client runtimes

package "Server-side OPC UA runtime" as ServerSide {
  rectangle "**OpcUaModule**\nserver/opcua\nconfig + certificate loading" as Module $tier
  rectangle "**Server**\ncommon/opcua\nopc.tcp endpoint adapter" as Server $tier
  rectangle "**opcuapp::server::Endpoint**\nUA Binary listener" as Endpoint $tier
  rectangle "**SCADA services**\nattribute / view / monitored-item /\nnode-management / method" as Services $tier
}

package "Client-side OPC UA runtime" as ClientSide {
  rectangle "**CreateServices(...)**\nDataServices factory" as Factory $tier
  rectangle "**ClientSession**\ncommon/opcua\nSessionService + service adapters" as Session $tier
  rectangle "**ClientSubscription**\ncommon/opcua\nmonitored-item batching" as Subscription $tier
  rectangle "**opcuapp client channel + session**\nremote opc.tcp endpoint" as Channel $tier
}

rectangle "**opcua_conversion.***\nOPC UA ↔ SCADA type mapping" as Conversion $tier
rectangle "Shared callers / features" as Client $external
rectangle "External OPC UA peer" as UaPeer $external

Module --> Server
Server --> Endpoint
Server --> Services
Server --> Conversion
Endpoint <--> UaPeer : UA Binary

Client --> Factory
Factory --> Session
Session --> Channel
Session --> Subscription
Session --> Conversion
Subscription --> Channel
Channel <--> UaPeer : UA Binary

@enduml
