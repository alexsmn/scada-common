@startuml opcua_session_sequence
!include _style.puml

title OPC UA over WebSocket — session lifecycle

autonumber

participant "Browser (UaClient)" as B $external
participant "WebSocketTransport" as WST $tier
participant "WsServer" as WS $tier
participant "opcua::ServerRuntime" as RT $neutral
participant "ServerSession" as S $tier
participant "ServerSessionManager" as M $tier
participant "SecurityService" as SEC $tier

note over B, WST
  WebSocketTransport accepts WS/WSS and enforces
  path, subprotocol, and allowed Origin
end note

B -> WST : GET /ua\nUpgrade: websocket\nSec-WebSocket-Protocol: opcua+uajson\nOrigin: https://scada.local
WST -> WST : validate path + subprotocol + allowed origin
WST --> B : 101 Switching Protocols
WST -> WS : accepted websocket transport

B -> S : requestHandle=1\nCreateSessionRequest (JSON)
S -> RT : decoded request envelope
RT -> M : CreateSession(requestedTimeout)
M --> S : SessionId + AuthenticationToken +\nServerNonce + RevisedTimeout
S --> B : requestHandle=1\nCreateSessionResponse

B -> S : requestHandle=2\nActivateSessionRequest\n(UserNameIdentityToken: PBKDF2(password, nonce))
S -> RT : decoded request envelope
RT -> M : ActivateSession(sessionId, token, credentials)
M -> SEC : authenticate(user, token)
SEC --> M : identity accepted
M --> RT : attached session + scada::ServiceContext
RT -> S : attach/create ServerSession
S --> B : requestHandle=2\nActivateSessionResponse

note over B, M : Data plane opens after the session is attached
note over B, RT
  Implemented in common today: opcua::ServerRuntime routes
  decoded request bodies through ServerSessionManager,
  ServerSession, and opcua::ServiceHandler
end note

note over B, S : Connection drops, browser reconnects before timeout

S -> RT : disconnect / detach
RT -> M : DetachSession(authenticationToken)
B -> S : requestHandle=3\nActivateSessionRequest(sessionId, token)
S -> RT : decoded request envelope
RT -> M : ActivateSession(resume)
M --> RT : resumed attached session
RT -> S : reattach existing ServerSession
S --> B : requestHandle=3\nActivateSessionResponse(resumed=true)

B -> S : requestHandle=4\nCloseSessionRequest
S -> RT : decoded request envelope
RT -> M : CloseSession(sessionId, token)
M --> S : session removed
S --> B : requestHandle=4\nCloseSessionResponse
WST --> B : Close frame (1000)

@enduml
