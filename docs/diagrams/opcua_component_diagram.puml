@startuml opcua_component_diagram
!include _style.puml

title OPC UA components — two transports, one canonical core

left to right direction

package "Clients" as Clients {
  rectangle "**Native OPC UA clients**\nQt client / 3rd-party tools" as NATIVE $external
  rectangle "**Browser client**\nweb/opcua-client" as BROWSER $external
}

package "Transport adapters" as Adapters {
  rectangle "**Binary adapter**\nserver\nruntime" as BIN $tier
  rectangle "**WebSocket adapter**\nwebsocket_transport\nserver\njson_codec" as WS $tier
}

package "Shared canonical core" as Core {
  rectangle "**opcua:: message model**\nRequestBody / ResponseBody" as MSG $neutral
  rectangle "**opcua::ServerRuntime**\nrequest routing" as RT $neutral
  rectangle "**opcua::ServerSessionManager**\nsession lifecycle" as SMGR $neutral
  rectangle "**opcua::ServerSession**\nlive session state" as SESS $neutral
  rectangle "**opcua::ServerSubscription**\npublish + replay" as SUB $neutral
  rectangle "**opcua::ServiceHandler**\ncoroutine dispatch" as HANDLER $neutral
}

package "Server services" as Services {
  rectangle "**DataServices**\naggregate runtime boundary" as CTX $tier
  rectangle "AttributeService" as ATTR $tier
  rectangle "ViewService" as VIEW $tier
  rectangle "HistoryService" as HIST $tier
  rectangle "MethodService" as METH $tier
  rectangle "NodeManagementService" as NODE $tier
  rectangle "MonitoredItemService" as MON $tier
}

rectangle "**server/opcua/opcua_module.***\nconfigures both endpoints" as MOD $config

NATIVE --> BIN : opc.tcp / UA Binary
BROWSER --> WS : opc.ws / opc.wss / UA-JSON

BIN --> MSG
WS --> MSG
MSG --> RT
RT --> SMGR
RT --> SESS
RT --> HANDLER
SESS --> SUB
SESS --> SMGR
HANDLER --> CTX
SMGR --> CTX
CTX --> ATTR
CTX --> VIEW
CTX --> HIST
CTX --> METH
CTX --> NODE
CTX --> MON

MOD ..> BIN : hosts/configures
MOD ..> WS : hosts/configures

@enduml
